# ==============================================================================
# Tattva AI - Frontend Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and configure for local development or AWS deployment.
# Never commit actual secret values, API keys, or AWS access keys.
# ==============================================================================

# Backend API URL
# Local development: http://localhost:8000
# AWS Production: https://<API_ID>.execute-api.us-east-1.amazonaws.com
VITE_API_BASE_URL=http://localhost:8000

# Application Metadata
VITE_APP_NAME=TattvaAI
VITE_APP_VERSION=1.0.0
VITE_NODE_ENV=development

# Feature Flags
VITE_ENABLE_DEMO_MODE=true
VITE_ENABLE_DEBUG_LOGGING=false

# Optional SigNoz Direct Connection (leave empty for vendor-neutral / offline mode)
VITE_SIGNOZ_URL=
