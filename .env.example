# ==============================================================================
# Tattva AI - Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and configure for your local or AWS environment.
# Never commit actual secret values, API keys, or AWS access keys to source control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
APP_NAME=Tattva AI
APP_VERSION=1.0.0
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Demo Mode (true enables deterministic offline telemetry & mock Bedrock reasoning)
DEMO_MODE=true

# Telemetry Source Configuration ('mock', 'otlp', or 'signoz')
TELEMETRY_SOURCE=mock
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=tattva-ai-backend

# Optional SigNoz Integration (leave empty for vendor-neutral / offline mode)
SIGNOZ_URL=
SIGNOZ_API_KEY=
SIGNOZ_MCP_SERVER=

# Generic MCP / Evidence Access Layer
MCP_SERVER_URL=
MCP_TIMEOUT_SECONDS=10.0

# ------------------------------------------------------------------------------
# AWS Service Configurations (Set AWS_ENABLED=true for AWS deployment)
# ------------------------------------------------------------------------------
AWS_ENABLED=false
AWS_REGION=us-east-1

# Amazon Bedrock Reasoning Provider
BEDROCK_ENABLED=false
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6

# Persistence Provider ('sqlite' for local development, 'dynamodb' for AWS serverless)
PERSISTENCE_PROVIDER=sqlite
DYNAMODB_TABLE_NAME=tattvaai_investigations

# Report Storage Provider ('local' for disk archive, 's3' for AWS S3 bucket archive)
REPORT_STORAGE_PROVIDER=local
S3_REPORT_BUCKET=tattvaai-investigation-reports
S3_REGION=us-east-1

# AWS Secrets Manager (fetches production secrets via IAM role)
SECRETS_MANAGER_ENABLED=false
AWS_SECRET_NAME=tattvaai/production/secrets

# Frontend API Endpoint Configuration (Used by Vite frontend build/runtime)
VITE_API_BASE_URL=http://localhost:8000

# Strict CORS Frontend Origin (e.g. https://tattvaai.company.com or http://localhost:5173)
FRONTEND_ORIGIN=http://localhost:5173
